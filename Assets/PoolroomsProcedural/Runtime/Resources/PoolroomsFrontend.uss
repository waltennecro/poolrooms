.fe-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(239, 237, 222); font-size: 16px; }
.fe-background { position: absolute; left: 0; right: 0; top: 0; bottom: 0; width: 100%; height: 100%; }
.fe-shade { position: absolute; left: 0; top: 0; bottom: 0; width: 64%; background-color: rgba(5, 15, 18, .82); border-right-width: 1px; border-right-color: rgba(229, 207, 153, .14); }
.fe-card { position: absolute; left: 7%; top: 6%; bottom: 11%; width: 38%; max-width: 630px; }
.fe-wide { width: 51%; max-width: 840px; }
.fe-kicker { font-size: 11px; color: rgb(190, 180, 143); margin-bottom: 16px; white-space: normal; letter-spacing: 2px; }
.fe-title { font-size: 62px; -unity-font-style: bold; white-space: normal; color: rgb(248, 242, 219); margin-bottom: 16px; }
.fe-title-small { font-size: 39px; }
.fe-caption { font-size: 17px; white-space: normal; color: rgb(198, 207, 197); margin-bottom: 24px; }
.fe-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.fe-button { min-height: 41px; flex-shrink: 0; padding: 8px 18px; margin: 3px 0; background-color: rgba(17, 31, 34, .72); color: rgb(231, 235, 221); border-width: 1px; border-color: rgba(198, 196, 164, .2); -unity-text-align: middle-left; white-space: normal; }
.fe-button:hover, .fe-button:focus, .fe-selected { background-color: rgba(125, 114, 78, .5); border-color: rgb(211, 192, 137); color: rgb(255, 249, 223); }
.fe-button:disabled { color: rgb(105, 123, 121); background-color: rgba(12, 23, 27, .5); }
.fe-note { white-space: normal; color: rgb(186, 200, 191); font-size: 14px; margin: 13px 3px; }
.fe-selection { color: rgb(244, 218, 158); font-size: 24px; white-space: normal; margin: 12px 0; }
.fe-field { margin: 9px 0; padding: 8px; min-height: 38px; flex-shrink: 0; color: rgb(231, 234, 218); background-color: rgba(21, 34, 37, .92); }
.fe-field > .unity-base-field__label { min-width: 130px; white-space: normal; }
.fe-option { flex-shrink: 0; padding: 0 10px 10px 4px; }
.fe-slider { min-height: 24px; }
.fe-scroll { flex-grow: 1; flex-shrink: 1; min-height: 80px; background-color: rgba(5, 15, 18, .42); padding: 6px 12px; }
.fe-tabs { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; flex-shrink: 0; }
.fe-tabs .fe-button { margin-right: 5px; }
.fe-footer { position: absolute; left: 7%; bottom: 5%; max-width: 78%; white-space: normal; color: rgb(207, 207, 185); font-size: 13px; }
.fe-credits { white-space: normal; font-size: 13px; color: rgb(199, 207, 193); }
.fe-error { white-space: normal; margin: 12px 0; color: rgb(245, 181, 139); }
.fe-modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(4, 10, 14, .88); align-items: center; justify-content: center; }
.fe-dialog { max-width: 86%; width: 600px; padding: 32px; background-color: rgb(18, 32, 36); border-width: 1px; border-color: rgb(168, 152, 112); }
.fe-dialog-title { font-size: 27px; white-space: normal; color: rgb(247, 233, 197); }
.fe-compact .fe-card { left: 5%; width: 88%; max-width: 850px; }
.fe-compact .fe-shade { width: 100%; background-color: rgba(5, 15, 18, .85); }
.fe-compact .fe-title { font-size: 42px; }
.fe-compact .fe-title-small { font-size: 30px; }
.fe-compact .fe-caption { margin-bottom: 12px; }
.fe-compact .fe-button { min-height: 35px; }
.fe-high-contrast .fe-shade { background-color: rgba(2, 6, 9, .96); }
