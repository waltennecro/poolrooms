<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- Only the immutable R33 room-comparison build uses this property. It has
       no wing implementation; the current build must keep the wing checks. -->
  <PropertyGroup Condition="'$(PoolroomsHistoricalCore)' == 'true'">
    <DefineConstants>$(DefineConstants);POOLROOMS_HISTORICAL_CORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/PoolroomsProcedural/Core/**/*.cs" />
    <Compile Include="Checks.cs" />
    <Compile Include="ExplorationChecks.cs" />
    <Compile Include="WaterOpticsChecks.cs" />
    <Compile Include="CameraAvatarChecks.cs" />
    <Compile Include="HumanoidChecks.cs" />
    <Compile Include="MallAtlas.cs" Condition="'$(PoolroomsHistoricalCore)' != 'true'" />
    <Compile Include="JourneyLevelChecks.cs" Condition="'$(PoolroomsHistoricalCore)' != 'true'" />
    <Compile Include="MallRealismChecks.cs" Condition="'$(PoolroomsHistoricalCore)' != 'true'" />
    <Compile Include="LargeRegionChecks.cs" Condition="'$(PoolroomsHistoricalCore)' != 'true'" />
    <Compile Include="SpecialRegionChecks.cs" Condition="'$(PoolroomsHistoricalCore)' != 'true'" />
    <Compile Include="ImmersionStationChecks.cs" Condition="'$(PoolroomsHistoricalCore)' != 'true'" />
    <Compile Include="EncounterChecks.cs" Condition="'$(PoolroomsHistoricalCore)' != 'true'" />
    <Compile Include="ImmersiveAudioChecks.cs" Condition="'$(PoolroomsHistoricalCore)' != 'true'" />
    <Compile Include="WingChecks.cs" Condition="'$(PoolroomsHistoricalCore)' != 'true'" />
    <Compile Include="GenerationAuditChecks.cs" />
    <Compile Include="VarietyExpansionChecks.cs" />
    <Compile Include="BiomeExtentChecks.cs" />
    <Compile Include="RestfulExpansionChecks.cs" />
    <Compile Include="RestfulBatchChecks.cs" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
</Project>
